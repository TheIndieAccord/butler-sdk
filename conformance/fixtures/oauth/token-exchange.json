{
  "name": "token-exchange",
  "description": "With a fixed verifier the authorize URL carries its S256 challenge. A valid redirect is exchanged for tokens with that verifier, then the SDK reads the player.",
  "config": {
    "doormanUrl": "https://doorman.test",
    "ingestToken": "00000000-0000-4000-8000-000000000001",
    "proxyKey": "pk_test_conformance",
    "consent": "granted",
    "build": "1.0.0",
    "installId": "install-fixture-1",
    "random": [
      0.5
    ],
    "oauth": {
      "clientId": "client_test",
      "redirectUri": "http://127.0.0.1:53682/callback",
      "scopes": [
        "profile:read"
      ],
      "integrationId": "00000000-0000-4000-8000-0000000000aa",
      "testVerifier": "fixture-verifier-0123456789-abcdefghijklmnopqrstuvwxyz"
    },
    "issuer": "https://api.butler.test"
  },
  "steps": [
    {
      "call": "signIn",
      "capture": "authorizeUrl"
    },
    {
      "call": "handleRedirect",
      "url": "http://127.0.0.1:53682/callback?code=abc&state=<captured:state>&iss=https%3A%2F%2Fapi.butler.test"
    },
    {
      "respond": {
        "status": 200,
        "body": {
          "access_token": "at_1",
          "token_type": "Bearer",
          "expires_in": 900,
          "refresh_token": "rt_1",
          "scope": "profile:read"
        }
      }
    },
    {
      "respond": {
        "status": 200,
        "body": {
          "player_id": "pseudonym-1",
          "display_name": "Tinsel",
          "avatar": {
            "kind": "initials",
            "image_url": null,
            "initials": "T"
          }
        }
      }
    }
  ],
  "expect": {
    "authorizeUrl": {
      "path": "/v1/oauth/authorize",
      "query": {
        "code_challenge": "FELHJTK_-lVsrXpQC2rESK7CZ255Q4S5NDfLTYLhcJI",
        "code_challenge_method": "S256",
        "state": "<any>"
      }
    },
    "requests": [
      {
        "method": "POST",
        "path": "/v1/oauth/token",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "grant_type": "authorization_code",
          "code": "abc",
          "code_verifier": "fixture-verifier-0123456789-abcdefghijklmnopqrstuvwxyz",
          "client_id": "client_test",
          "redirect_uri": "http://127.0.0.1:53682/callback"
        }
      },
      {
        "method": "GET",
        "path": "/v2/games/00000000-0000-4000-8000-0000000000aa/me",
        "headers": {
          "authorization": "Bearer at_1"
        }
      }
    ],
    "player": {
      "player_id": "pseudonym-1",
      "display_name": "Tinsel"
    }
  }
}
