{
  "name": "batch-404-falls-back",
  "description": "Doorman older than 1.4 answers 404 on /game/events/batch: the same events are re-sent one by one to /game/events with the same event_ids, and later flushes use singles for the rest of the session.",
  "config": {
    "doormanUrl": "https://doorman.test",
    "ingestToken": "00000000-0000-4000-8000-000000000001",
    "proxyKey": "pk_test_conformance",
    "consent": "granted",
    "build": "1.0.0",
    "installId": "install-fixture-1",
    "random": [
      0.5
    ]
  },
  "steps": [
    {
      "call": "track",
      "name": "a"
    },
    {
      "call": "track",
      "name": "b"
    },
    {
      "call": "flush"
    },
    {
      "respond": {
        "status": 200,
        "body": {
          "enabled": true,
          "sample_rates": {},
          "max_batch": 100,
          "ttl_s": 300
        }
      }
    },
    {
      "respond": {
        "status": 404
      }
    },
    {
      "respond": {
        "status": 200,
        "body": {
          "accepted": true,
          "status": "accepted",
          "duplicate": false
        }
      }
    },
    {
      "respond": {
        "status": 200,
        "body": {
          "accepted": true,
          "status": "accepted",
          "duplicate": false
        }
      }
    },
    {
      "call": "track",
      "name": "c"
    },
    {
      "call": "flush"
    }
  ],
  "expect": {
    "requests": [
      {
        "method": "GET",
        "path": "/game/config",
        "query": {
          "ingest_token": "00000000-0000-4000-8000-000000000001",
          "build": "1.0.0"
        },
        "headers": {
          "x-proxy-key": "pk_test_conformance"
        }
      },
      {
        "method": "POST",
        "path": "/game/events/batch",
        "query": {
          "ingest_token": "00000000-0000-4000-8000-000000000001"
        },
        "headers": {
          "x-proxy-key": "pk_test_conformance",
          "content-type": "application/json"
        },
        "body": {
