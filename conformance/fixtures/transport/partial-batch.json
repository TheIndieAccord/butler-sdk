{
  "name": "partial-batch",
  "description": "Per-index results: rejected events are dropped and not retried, duplicates count as delivered.",
  "config": {
    "doormanUrl": "https://doorman.test",
    "ingestToken": "00000000-0000-4000-8000-000000000001",
    "proxyKey": "pk_test_conformance",
    "consent": "granted",
    "build": "1.0.0",
    "installId": "install-fixture-1",
    "random": [
      0.5
    ]
  },
  "steps": [
    {
      "call": "track",
      "name": "a"
    },
    {
      "call": "track",
      "name": "b"
    },
    {
      "call": "track",
      "name": "c"
    },
    {
      "call": "flush"
    },
    {
      "respond": {
        "status": 200,
        "body": {
          "enabled": true,
          "sample_rates": {},
          "max_batch": 100,
          "ttl_s": 300
        }
      }
    },
    {
      "respond": {
        "status": 200,
        "body": {
          "accepted": 1,
          "duplicates": 1,
          "rejected": 1,
          "results": [
            {
              "index": 0,
              "accepted": true,
              "status": "accepted",
              "duplicate": false
            },
            {
              "index": 1,
              "accepted": false,
              "status": "rejected",
              "duplicate": false,
              "error": "metadata too large"
            },
            {
              "index": 2,
              "accepted": true,
              "status": "duplicate",
              "duplicate": true
            }
          ]
        }
      }
    },
    {
      "advance_ms": 600000
    }
  ],
  "expect": {
