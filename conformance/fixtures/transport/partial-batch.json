                "$platform": "<any>",
                "$build": "1.0.0"
              },
              "timestamp": "<iso8601>",
              "event_id": "<uuidv7>",
              "session_id": "<same:session>"
            },
            {
              "user_id": "<same:install>",
              "event_name": "b",
              "metadata": {
                "$sdk": "<any>",
                "$sdk_version": "<any>",
                "$platform": "<any>",
                "$build": "1.0.0"
              },
              "timestamp": "<iso8601>",
              "event_id": "<uuidv7>",
              "session_id": "<same:session>"
            },
            {
              "user_id": "<same:install>",
              "event_name": "c",
              "metadata": {
                "$sdk": "<any>",
                "$sdk_version": "<any>",
                "$platform": "<any>",
                "$build": "1.0.0"
              },
              "timestamp": "<iso8601>",
              "event_id": "<uuidv7>",
              "session_id": "<same:session>"
